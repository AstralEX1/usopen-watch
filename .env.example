# Polygon RPC endpoints. Keep at least two for the concurrent latency probe.
POLYGON_RPC_1=
POLYGON_RPC_2=
POLYGON_RPC_3=

# The only private key accepted by the automatic test path.
TEST_PRIVATE_KEY=
AUTO_TEST_PROPOSAL=false

# Optional startup overrides; defaults are the current Polygon deployment and a fixed safe gas limit.
POLYMARKET_UMA_ADAPTER=
UMA_GAS_LIMIT=350000
